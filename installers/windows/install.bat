@echo off
setlocal
title Universal Vault CLI Installer
set "BATDIR=%~dp0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$srcDir='%BATDIR%'; function Get-Hash($p){$s=[System.Security.Cryptography.SHA256]::Create();$f=[System.IO.File]::OpenRead($p);$h=[System.BitConverter]::ToString($s.ComputeHash($f)) -replace '-';$f.Close();return $h}; $src=Join-Path $srcDir 'vault.exe'; if(-not(Test-Path $src)){Write-Host '[-] Error: vault.exe not found in installer directory.' -ForegroundColor Red; exit 1}; $target=Join-Path $env:LOCALAPPDATA 'UniversalVault\bin'; $dest=Join-Path $target 'vault.exe'; Write-Host '======================================================================' -ForegroundColor Cyan; Write-Host '  Universal Vault CLI -- Windows 1-Click Installer' -ForegroundColor Cyan; Write-Host '======================================================================' -ForegroundColor Cyan; $srcHash=Get-Hash $src; Write-Host ('[*] Source Binary SHA-256 : ' + $srcHash) -ForegroundColor Gray; if(-not(Test-Path $target)){New-Item -ItemType Directory -Path $target -Force|Out-Null}; try{Copy-Item -Path $src -Destination $dest -Force -ErrorAction Stop}catch{Write-Host ('[-] Installation Failed: ' + $_.Exception.Message) -ForegroundColor Red; exit 1}; if(-not(Test-Path $dest)){Write-Host '[-] Verification Failed: vault.exe not found after copy.' -ForegroundColor Red; exit 1}; $destHash=Get-Hash $dest; if($srcHash -ne $destHash){Write-Host '[-] Verification Failed: SHA-256 mismatch!' -ForegroundColor Red; Remove-Item -Path $dest -Force; exit 1}; Write-Host ('[+] Deployed to           : ' + $dest) -ForegroundColor Green; Write-Host '[+] Copy Integrity        : SHA-256 matches source payload' -ForegroundColor Green; $userPath=[Environment]::GetEnvironmentVariable('Path', [EnvironmentVariableTarget]::User); $pathEntries=if($userPath){$userPath -split ';'|Where-Object{$_ -ne ''}}else{@()}; if($pathEntries -notcontains $target){$newUserPath=if($userPath){$target+';'+$userPath}else{$target}; [Environment]::SetEnvironmentVariable('Path', $newUserPath, [EnvironmentVariableTarget]::User); Write-Host ('[+] Registered in PATH    : ' + $target + ' (Prepended for priority)') -ForegroundColor Green}else{Write-Host '[*] PATH Registration     : Already registered in User PATH' -ForegroundColor Yellow}; Write-Host ''; Write-Host '======================================================================' -ForegroundColor Cyan; Write-Host '  Installation Successful (Copy Integrity Confirmed)' -ForegroundColor Green; Write-Host '  You can now open any Command Prompt or PowerShell and run:' -ForegroundColor Cyan; Write-Host '    vault lock <path>' -ForegroundColor White; Write-Host '    vault unlock <path>' -ForegroundColor White; Write-Host '    vault status <path>' -ForegroundColor White; Write-Host '======================================================================' -ForegroundColor Cyan"
echo.
pause
